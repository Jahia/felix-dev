<?xml version="1.0"?>
<settings>
    <servers>
        <!-- The Jahia branches of this fork do not agree on the server id they
             deploy to: fileinstall names thirdparty-*, webconsole names
             jahia-internal-*. Both ids point at the same Nexus repositories. -->
        <server>
            <id>thirdparty-releases</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>thirdparty-snapshots</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>jahia-internal-releases</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>jahia-internal-snapshots</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>
</settings>
